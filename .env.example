# Databuddy website id, safe to expose, used by the analytics script
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Databuddy API key with the track:events scope, server only, records cli installs
DATABUDDY_TRACK_API_KEY=

# neon postgres connection string, server only
DATABASE_URL=

# random 32+ char string, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# site origin, e.g. http://localhost:3000 in dev
BETTER_AUTH_URL=

# google oauth client, callback: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# polar organization access token, sandbox and production tokens are separate
POLAR_ACCESS_TOKEN=
# webhook endpoint: <BETTER_AUTH_URL>/api/auth/polar/webhooks
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
# sandbox or production
POLAR_SERVER=sandbox
